#!/usr/bin/env bash
# bin/devflow — wrapper for handyman-devflow plugin's Node CLI tools.
# Invokes plugin-shipped tsx scripts from any cwd.
set -euo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:?CLAUDE_PLUGIN_ROOT not set — is this running inside Claude Code with the plugin installed?}"

cmd="${1:-}"
shift || true

case "$cmd" in
  validate)
    # devflow validate <phase> <TICKET>
    phase="${1:?Usage: devflow validate <phase> <TICKET>}"
    ticket="${2:?Usage: devflow validate <phase> <TICKET>}"
    exec npx tsx "${PLUGIN_ROOT}/src/validators/${phase}.ts" "${ticket}"
    ;;
  journal)
    # devflow journal <TICKET> <PHASE> <STEP> <STATUS> [details]
    exec npx tsx "${PLUGIN_ROOT}/src/journal-cli.ts" "$@"
    ;;
  slug)
    # devflow slug "<text>"
    exec npx tsx "${PLUGIN_ROOT}/src/utils/slug-cli.ts" "$@"
    ;;
  config)
    # devflow config get <dotted.path>
    exec npx tsx "${PLUGIN_ROOT}/src/config-cli.ts" "$@"
    ;;
  smoke)
    # devflow smoke <TICKET> [--evidence-dir <dir>] [--label <name>]
    exec npx tsx "${PLUGIN_ROOT}/src/smoke-runner.ts" "$@"
    ;;
  state)
    # devflow state get <TICKET> [<field>]
    # devflow state increment-verify-attempt <TICKET>
    # devflow state reset-verify-attempts <TICKET>
    exec npx tsx "${PLUGIN_ROOT}/src/state-cli.ts" "$@"
    ;;
  *)
    cat >&2 <<EOF
devflow: handyman-devflow plugin CLI wrapper
Usage:
  devflow validate <phase> <TICKET>            # run a phase validator
  devflow journal <TICKET> <PHASE> <STEP> <STATUS> [details]  # append journal entry
  devflow slug "<text>"                        # slugify a title
  devflow config get <dotted.path>             # read a value from .dev-flow/config.yaml
  devflow smoke <TICKET> [--evidence-dir <dir>] [--label <name>]  # run real-condition smoke test
  devflow state get <TICKET> [<field>]         # read state.json (full or single field)
  devflow state increment-verify-attempt <TICKET>  # bump verify_attempts on judge FAIL/UNCLEAR
  devflow state reset-verify-attempts <TICKET>     # reset to 0 (after a clean verify PASS)
EOF
    exit 64
    ;;
esac
